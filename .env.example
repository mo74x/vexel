# ==============================================================================
# Vexel Core Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# App / Node Server Settings
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL & PgBouncer Database Connections
# ------------------------------------------------------------------------------
# Direct Postgres URL (used for migrations and schema introspection)
DIRECT_URL="postgresql://vexel:vexel_dev_password@localhost:5432/vexel_core"
# Transaction-mode pooled connection (PgBouncer default port: 6432)
DATABASE_URL="postgresql://vexel:vexel_dev_password@localhost:5432/vexel_core"

# ------------------------------------------------------------------------------
# Redis Connection (Locks, Buffers, Caches & BullMQ)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# Vexel Envelope Crypto (AES-256-GCM Key Encryption Keys)
# ------------------------------------------------------------------------------
# Active Key Version identifier (e.g., "v1", "v2")
VEXEL_ACTIVE_KEK_VERSION="v1"
# 64-character hex string representing a 256-bit (32-byte) master encryption key
VEXEL_KEK_V1="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# Optional rotated secondary key for transparent re-wrapping
# VEXEL_KEK_V2="fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"

# ------------------------------------------------------------------------------
# Internal Security & HMAC Verification
# ------------------------------------------------------------------------------
# Secret used for HMAC-signing WhatsApp interactive button IDs (Approve, Reject, Undo, Force-Undo)
VEXEL_APPROVAL_HMAC_SECRET="dev_approval_hmac_secret_key_minimum_32_chars"
# Shared secret required in x-vexel-api-key header for internal/admin endpoints
VEXEL_INTERNAL_API_KEY="dev_vexel_internal_secret_api_key_123"

# ------------------------------------------------------------------------------
# Meta WhatsApp Cloud API Credentials
# ------------------------------------------------------------------------------
# Meta App Secret used to verify X-Hub-Signature-256 header on incoming webhooks
META_APP_SECRET="your_meta_app_secret_here"
# Verification token configured in Meta App Dashboard for GET /v1/webhooks/:tenantId/ingest challenge
META_WEBHOOK_VERIFY_TOKEN="your_meta_webhook_verify_token"
# Default system-wide Meta Cloud API Phone Number ID
WHATSAPP_PHONE_NUMBER_ID="your_meta_whatsapp_phone_number_id"
# Default system-wide Meta System User Access Token (used when tenant has no sealed custom token)
WHATSAPP_SYSTEM_TOKEN="your_meta_system_user_access_token"
# Default fallback destination phone (E.164) when Deal owner is unassigned or unlinked
DEFAULT_REP_APPROVAL_PHONE="+201000000001"

# ------------------------------------------------------------------------------
# HubSpot OAuth 2.0 Integration
# ------------------------------------------------------------------------------
HUBSPOT_CLIENT_ID="your_hubspot_app_client_id"
HUBSPOT_CLIENT_SECRET="your_hubspot_app_client_secret"
HUBSPOT_REDIRECT_URI="http://localhost:3001/v1/hubspot/callback"

# ------------------------------------------------------------------------------
# AI LLM & Speech Transcription Providers
# ------------------------------------------------------------------------------
# OpenAI API Key (Whisper audio transcription & token metering)
OPENAI_API_KEY="sk-proj-your_openai_api_key_here"
# Anthropic API Key (Claude 3.7 / 3.5 Sonnet Zod-schema structured extraction)
ANTHROPIC_API_KEY="sk-ant-api03-your_anthropic_api_key_here"
